rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "krishan181982@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Suspended / Banned Identifiers collection
    match /banned_identifiers/{banId} {
      allow read: if true;
      allow write: if true;
    }

    // Workers / Specialists collection
    match /workers/{workerId} {
      allow read: if true;
      allow write: if true;
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read: if true;
      allow write: if true;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }

    // Emergency Requests collection
    match /emergencyRequests/{requestId} {
      allow read: if true;
      allow write: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
